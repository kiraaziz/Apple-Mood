{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apple-mood",
  "version": "0.1.0",
  "identifier": "com.kira.applemood",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "Apple-Mood",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "width": 300,
        "height": 200,
        "minWidth": 200,
        "minHeight": 100,
        "maxWidth": 500,
        "maxHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}